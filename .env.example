APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=discord_bot
POSTGRES_USER=discord_bot
POSTGRES_PASSWORD=discord_bot
DATABASE_URL=postgresql+asyncpg://discord_bot:discord_bot@postgres:5432/discord_bot

# Discord bot and OAuth application
DISCORD_BOT_TOKEN=replace-me
DISCORD_CLIENT_ID=replace-me
DISCORD_CLIENT_SECRET=replace-me
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback

# Dashboard/API domains
WEB_DOMAIN=http://localhost:5173
API_DOMAIN=http://localhost:8000
COOKIE_DOMAIN=
CORS_EXTRA_ORIGINS=

# Sessions and CSRF
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=dashboard_session
CSRF_COOKIE_NAME=csrf_token
SESSION_TTL_SECONDS=604800

# Bot workers
PUBLISH_POLL_INTERVAL_SECONDS=30

# Production HTTPS
CADDY_EMAIL=admin@example.com

# Frontend build/runtime
VITE_API_BASE_URL=http://localhost:8000
